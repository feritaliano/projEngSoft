{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker --version)",
      "Bash(docker compose version)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up -d)",
      "Bash(docker compose up -d *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm run db:validate)",
      "Bash(npm run db:drift)",
      "Bash(npm run db:test)",
      "Bash(npm run db:migrate)",
      "Bash(npm run db:ddl)",
      "Bash(npm run db:generate)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run test:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(npm run build *)",
      "Bash(npx prisma validate *)",
      "Bash(npx prisma format *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx jest *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(docker compose down *)",
      "Bash(docker exec *)",
      "Bash(npm run db:reset *)",
      "Bash(npm run db:reset)",
      "Bash(npm run db:migrate:dev *)",
      "Bash(npm run db:migrate:dev)",
      "Bash(npx prisma migrate *)",
      "Bash(npm install *)",
      "Bash(git push *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.*.local)",
      "Bash(docker compose config *)",
      "Bash(docker compose config)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)"
    ]
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  }
}
