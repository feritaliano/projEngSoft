# Copie para .env (o .env não vai para o Git)
POSTGRES_USER=carteira
POSTGRES_PASSWORD=troque-esta-senha

# Usadas pelo Prisma e pelos testes
DATABASE_URL=postgresql://carteira:troque-esta-senha@localhost:5432/carteira_dev
SHADOW_DATABASE_URL=postgresql://carteira:troque-esta-senha@localhost:5432/carteira_shadow
DATABASE_URL_TEST=postgresql://carteira:troque-esta-senha@localhost:5432/carteira_test
