# Copie para .env (o .env não vai para o Git)
POSTGRES_USER=carteira
POSTGRES_PASSWORD=troque-esta-senha

# Usadas pelo Prisma (migrations e diff)
DATABASE_URL=postgresql://carteira:troque-esta-senha@localhost:5432/carteira_dev
SHADOW_DATABASE_URL=postgresql://carteira:troque-esta-senha@localhost:5432/carteira_shadow
# Banco do E2E do frontend na máquina local (D40); os testes do backend usam Testcontainers e não leem esta variável
DATABASE_URL_TEST=postgresql://carteira:troque-esta-senha@localhost:5432/carteira_test

# Backend (K1, D52): api e worker validam estas variáveis com zod no boot e não sobem se faltar alguma
NODE_ENV=development
# Origem do frontend (esquema, host e porta; sem barra no fim): a única aceita pelo CORS
CORS_ORIGIN=http://localhost:4200
API_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
