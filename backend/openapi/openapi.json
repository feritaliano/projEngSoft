{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "PostgreSQL answers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOkDto"
                }
              }
            }
          },
          "503": {
            "description": "A dependency does not answer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailableProblemDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "E-mail already registered (field: email)."
          },
          "429": {
            "description": "Too many attempts."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "E-mail or password is incorrect."
          },
          "429": {
            "description": "Too many attempts."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Session expired or revoked."
          }
        },
        "security": [
          {
            "refresh_token": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "refresh_token": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Carteira B3 API",
    "description": "API REST da Carteira B3. Erros em RFC 7807 (application/problem+json); decimais como string; datas ISO 8601.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "IndicatorStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthUnavailableProblemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Not Found"
          },
          "status": {
            "type": "number",
            "example": 404
          },
          "detail": {
            "type": "string",
            "example": "Cannot GET /api/v1/does-not-exist"
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/does-not-exist"
          },
          "errors": {
            "description": "One message per invalid field (400).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            },
            "example": {
              "database": "down"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "checks"
        ]
      },
      "HealthOkDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "info": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/IndicatorStatusDto"
            },
            "example": {
              "database": {
                "status": "up"
              }
            }
          },
          "error": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/IndicatorStatusDto"
            },
            "example": {}
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/IndicatorStatusDto"
            },
            "example": {
              "database": {
                "status": "up"
              }
            }
          }
        },
        "required": [
          "status",
          "info",
          "error",
          "details"
        ]
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana Souza",
            "maxLength": 150
          },
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "RN01: at least 8 characters."
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived JWT for Authorization: Bearer."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds.",
            "example": 900
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "LogInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    }
  }
}
