{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "PostgreSQL answers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOkDto"
                }
              }
            }
          },
          "503": {
            "description": "A dependency does not answer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ProblemDetails"
                    },
                    {
                      "$ref": "#/components/schemas/HealthChecksProblemDto"
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Health check of the API and PostgreSQL (D52)",
        "tags": [
          "health"
        ],
        "security": []
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body: errors[] names each field (name, email, password, or a field that should not exist).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "E-mail already registered (field: email).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Sign up and start a session (A1, RN01)",
        "tags": [
          "auth"
        ],
        "security": []
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body: errors[] names each field (email, password, or a field that should not exist).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "E-mail or password is incorrect.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Log in (A2)",
        "tags": [
          "auth"
        ],
        "security": []
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Session expired or revoked.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "refresh_token": []
          }
        ],
        "summary": "Rotate the refresh cookie and issue a new access token (D39)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "refresh_token": []
          }
        ],
        "summary": "Log out: revoke the session family (D39)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/assets": {
      "get": {
        "operationId": "AssetsController_search",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Part of the ticker or of the issuer name, ignoring case and accents. Empty lists the whole catalog.",
            "schema": {
              "maxLength": 100,
              "example": "itausa",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100000,
              "default": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query: errors[] names each parameter (search, page, pageSize).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Search the asset catalog (C1)",
        "tags": [
          "reference-data"
        ]
      }
    },
    "/api/v1/assets/{ticker}": {
      "get": {
        "operationId": "AssetsController_get",
        "parameters": [
          {
            "name": "ticker",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No active asset with this ticker.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Get an asset by ticker (C1)",
        "tags": [
          "reference-data"
        ]
      }
    },
    "/api/v1/brokers": {
      "get": {
        "operationId": "BrokersController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BrokerDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "List brokers and exchanges (RN04, D9)",
        "tags": [
          "reference-data"
        ]
      }
    },
    "/api/v1/portfolios": {
      "get": {
        "operationId": "PortfoliosController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PortfolioDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "List the portfolios of the user (B1)",
        "tags": [
          "portfolios"
        ]
      },
      "post": {
        "operationId": "PortfoliosController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePortfolioDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body: errors[] names each field (name, or a field that should not exist).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The user already has a portfolio with this name (field: name).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Create a portfolio (B1, RN02)",
        "tags": [
          "portfolios"
        ]
      }
    },
    "/api/v1/portfolios/{id}": {
      "get": {
        "operationId": "PortfoliosController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Portfolio not found, or it belongs to another user (RN02).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Get a portfolio of the user (RN02)",
        "tags": [
          "portfolios"
        ]
      },
      "delete": {
        "operationId": "PortfoliosController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted, with its operations (ON DELETE CASCADE)."
          },
          "401": {
            "description": "Missing, malformed or expired access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Portfolio not found, or it belongs to another user (RN02).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Delete a portfolio and its operations (B1, D41)",
        "tags": [
          "portfolios"
        ]
      }
    }
  },
  "info": {
    "title": "Carteira B3 API",
    "description": "API REST da Carteira B3. Erros em RFC 7807 (application/problem+json, schema ProblemDetails); decimais como string; datas ISO 8601. Rotas protegidas exigem o access token (Authorization: Bearer).",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token (accessToken) returned by /auth/register, /auth/login and /auth/refresh."
      },
      "refresh_token": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token",
        "description": "httpOnly refresh token cookie set by /auth/register, /auth/login and /auth/refresh (Path=/api/v1/auth)."
      }
    },
    "schemas": {
      "IndicatorStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up"
          }
        },
        "required": [
          "status"
        ]
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "password",
            "description": "Property path in the body or query string; nested properties use dots (address.street, items.0.quantity)."
          },
          "message": {
            "type": "string",
            "example": "password must be longer than or equal to 8 characters"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "The request is invalid."
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/auth/register"
          },
          "errors": {
            "maxItems": 50,
            "description": "400 only: one entry per invalid input, from validation of the body or query and from domain rules (at most 50).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "field": {
            "type": "string",
            "example": "email",
            "description": "409 only: the field whose value conflicts with an existing resource (e.g. e-mail already registered)."
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "HealthChecksProblemDto": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            },
            "example": {
              "database": "down"
            }
          }
        },
        "required": [
          "checks"
        ]
      },
      "HealthOkDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "info": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/IndicatorStatusDto"
            },
            "example": {
              "database": {
                "status": "up"
              }
            }
          },
          "error": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/IndicatorStatusDto"
            },
            "example": {}
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/IndicatorStatusDto"
            },
            "example": {
              "database": {
                "status": "up"
              }
            }
          }
        },
        "required": [
          "status",
          "info",
          "error",
          "details"
        ]
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana Souza",
            "maxLength": 150
          },
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "RN01: at least 8 characters."
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived JWT for Authorization: Bearer."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds.",
            "example": 900
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "LogInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AssetType": {
        "type": "string",
        "enum": [
          "STOCK",
          "FII",
          "ETF",
          "BDR",
          "FIXED_INCOME",
          "CRYPTO"
        ]
      },
      "AssetDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "6b0d3a52-1f5e-4f0a-9d7c-3e2b8a1c4d90"
          },
          "ticker": {
            "type": "string",
            "nullable": true,
            "example": "ITSA4",
            "description": "Null for fixed income (D50)."
          },
          "assetType": {
            "example": "STOCK",
            "allOf": [
              {
                "$ref": "#/components/schemas/AssetType"
              }
            ]
          },
          "displayName": {
            "type": "string",
            "example": "ITSA4",
            "description": "Ticker for stocks, FIIs, ETFs and BDRs; name for crypto; bond type and maturity year for fixed income (D50)."
          },
          "issuer": {
            "type": "string",
            "nullable": true,
            "example": "Itaúsa S.A.",
            "description": "Issuer name; null for crypto."
          },
          "sector": {
            "type": "string",
            "nullable": true,
            "example": "Financeiro",
            "description": "Sector of the issuer, when it has one."
          }
        },
        "required": [
          "id",
          "ticker",
          "assetType",
          "displayName",
          "issuer",
          "sector"
        ]
      },
      "AssetPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetDto"
            }
          },
          "total": {
            "type": "number",
            "example": 1,
            "description": "Assets matching the search, across all pages."
          }
        },
        "required": [
          "items",
          "total"
        ]
      },
      "BrokerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0c9e7f3a-5b2d-4e81-a6c4-9d1f2b3e4a57"
          },
          "name": {
            "type": "string",
            "example": "XP Investimentos CCTVM S.A."
          },
          "cnpj": {
            "type": "string",
            "nullable": true,
            "example": "02332886000104",
            "description": "14 digits; null for an exchange without CNPJ (D50)."
          }
        },
        "required": [
          "id",
          "name",
          "cnpj"
        ]
      },
      "PortfolioDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3f1c2b9e-8d4a-4c6f-9b1e-2a7d5c8e0f13"
          },
          "name": {
            "type": "string",
            "example": "Longo prazo"
          },
          "operationCount": {
            "type": "number",
            "example": 11,
            "description": "Operations of the portfolio, counted in the query (D41). Shown when confirming the deletion: they go with it."
          },
          "assetCount": {
            "type": "number",
            "example": 6,
            "description": "Assets with an open position (quantity > 0), derived from the operations by the position calculator (RN09); closed positions do not count."
          }
        },
        "required": [
          "id",
          "name",
          "operationCount",
          "assetCount"
        ]
      },
      "CreatePortfolioDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Longo prazo",
            "maxLength": 150,
            "description": "RN02: unique per user (case-sensitive), trimmed, 1 to 150 characters."
          }
        },
        "required": [
          "name"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
